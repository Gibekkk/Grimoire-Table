rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isDm(campaignId) {
      return signedIn() &&
        get(/databases/$(database)/documents/campaigns/$(campaignId)).data.dmUid == request.auth.uid;
    }
    function isMember(campaignId) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/campaigns/$(campaignId)).data.memberUids;
    }

    match /campaigns/{campaignId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.dmUid == request.auth.uid;
      // Starter rule: any signed-in user can update (covers joining by invite code
      // and the DM editing campaign fields). Tighten this once your player list is stable.
      allow update: if signedIn();
      allow delete: if isDm(campaignId);

      match /log/{entryId} {
        allow read, create: if isMember(campaignId);
        allow update: if false;
        allow delete: if isDm(campaignId); // needed so a DM can cascade-delete the campaign
      }

      match /partyInventory/{itemId} {
        allow read, write: if isMember(campaignId);
      }

      match /notes/{noteId} {
        allow read, write: if isDm(campaignId);
      }

      match /maps/{mapId} {
        allow read: if isMember(campaignId);
        allow create, delete: if isDm(campaignId);
        // DM can change anything; any member can place/clear AoE shapes
        // (their own spell's area) without touching the rest of the map.
        allow update: if isDm(campaignId) ||
          (isMember(campaignId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["aoeShapes"]));

        match /tokens/{tokenId} {
          function tokenOwnerUid() {
            return get(/databases/$(database)/documents/characters/$(resource.data.refId)).data.ownerUid;
          }
          allow read: if isMember(campaignId);
          allow create, delete: if isDm(campaignId);
          // A player may move only their own PC's token; the DM may move any token.
          allow update: if isDm(campaignId) || (isMember(campaignId) && resource.data.kind == "pc" && tokenOwnerUid() == request.auth.uid);
        }

        // Loot physically in this room/map — any member can drop or take
        // items; the DM can add or override anything (encounter loot, etc.).
        match /roomInventory/{itemId} {
          allow read, write: if isMember(campaignId);
        }
      }

      match /componentFolders/{folderId} { allow read: if isMember(campaignId); allow write: if isDm(campaignId); }
      match /componentLibrary/{componentId} { allow read: if isMember(campaignId); allow write: if isDm(campaignId); }
      match /relationships/{relId} { allow read, write: if isDm(campaignId); }

      match /combat/{docId} {
        // Starter rule: any member can update (players toggle their own action
        // economy and roll their own initiative). Tighten with per-field
        // validation later if a player misusing this becomes a real problem.
        allow read: if isMember(campaignId);
        allow write: if isMember(campaignId);
      }
    }

    match /characters/{characterId} {
      allow read: if signedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        (resource.data.campaignId != null && isMember(resource.data.campaignId))
      );
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        (resource.data.campaignId != null && isDm(resource.data.campaignId))
      );
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /inventory/{itemId} {
        function character() { return get(/databases/$(database)/documents/characters/$(characterId)).data; }
        allow read: if signedIn() && (
          character().ownerUid == request.auth.uid ||
          (character().campaignId != null && isMember(character().campaignId))
        );
        allow write: if signedIn() && character().ownerUid == request.auth.uid;
      }
    }

    // Rulebook reference data (species/classes/backgrounds/skills/feats/equipment).
    // Public read so the app works for signed-in players; write only via the
    // Admin SDK import script (scripts/import-rules-data.js), never the browser.
    match /rules_species/{id}      { allow read: if signedIn(); allow write: if false; }
    match /rules_classes/{id}      { allow read: if signedIn(); allow write: if false; }
    match /rules_backgrounds/{id}  { allow read: if signedIn(); allow write: if false; }
    match /rules_skills/{id}       { allow read: if signedIn(); allow write: if false; }
    match /rules_feats/{id}        { allow read: if signedIn(); allow write: if false; }
    match /rules_spells/{id}       { allow read: if signedIn(); allow write: if false; }
    match /rules_class_features/{id} { allow read: if signedIn(); allow write: if false; }
    match /rules_monsters/{id}       { allow read: if signedIn(); allow write: if false; }
    match /rules_meta/{id}         { allow read: if signedIn(); allow write: if false; }
  }
}
